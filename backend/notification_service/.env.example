# Database — this service owns notification_db exclusively (§13)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/notification_db

# Must match the SECRET_KEY used by every other service in this LMS
# (see backend/app/backend_auth_utilities.py). This lets a normal user's
# Bearer token, issued by auth_service, be verified here without an
# extra round-trip to auth_service.
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256

# Shared secret that producing services attach to internal event calls.
# CHANGE THIS in every real deployment — it is the only thing standing
# between /internal/notifications/events and the open internet.
NOTIFICATION_INTERNAL_API_KEY=change-this-internal-notification-key

# Pagination
NOTIFICATION_DEFAULT_PAGE_SIZE=20
NOTIFICATION_MAX_PAGE_SIZE=100
NOTIFICATION_RECENT_LIMIT=10

# Defensive cap on recipients per single event (§52 payload-size limits)
NOTIFICATION_MAX_RECIPIENTS=5000

# Optional retention default, used only if a cleanup job is added later
NOTIFICATION_DEFAULT_EXPIRY_DAYS=90
