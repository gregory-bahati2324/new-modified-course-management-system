# ---------------------------------------------------------------------------
# Frontend environment (only used for LOCAL development with `npm run dev`).
#
# PRODUCTION does not read this file: the Docker build sets every base URL to "" (same origin) and
# nginx routes each URL prefix to the right microservice. See ../DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Local dev against the docker-compose.dev.yml stack (services published on localhost ports):
VITE_API_BASE_URL=http://localhost:8000
VITE_API_COURSE_BASE_URL_COURSE=http://localhost:8001
VITE_API_MODULE_LESSON_BASE_URL=http://localhost:8002
VITE_API_ASSIGNMENT_BASE_URL=http://localhost:8003
VITE_API_PROGRESS_BASE_URL=http://localhost:8004
VITE_API_MARKING_GRADING_BASE_URL=http://localhost:8005
VITE_API_SCHEDULING_BASE_URL=http://localhost:8006
VITE_API_NOTIFICATION_BASE_URL=http://localhost:8007
VITE_USE_MOCK_DATA=false

# ...or run `npm run dev` against a deployed server / the nginx container (same-origin proxy):
#   leave every *_BASE_URL empty ("") and set a Vite dev proxy, or just open the deployed site.
