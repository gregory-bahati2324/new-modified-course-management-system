# =============================================================================
#  PRODUCTION environment for docker-compose.yml
#
#    cp .env.example .env
#    nano .env                  # fill in the 4 values below
#    docker compose up -d --build
#
#  This file is never read by Docker itself - only Compose reads .env, and only on the
#  machine where you run `docker compose`. It must NOT be committed with real secrets in it.
# =============================================================================

# --- Your domain -------------------------------------------------------------------------------
# Leave as "_" to serve plain HTTP on the server's IP address. Set it to your real domain
# (e.g. greg-1-learning-managment-system.duckdns.org) once DNS points at this server AND you
# have run certbot (see DEPLOYMENT.md) - nginx then serves HTTPS on that domain automatically.
SERVER_NAME=_

# --- Database ----------------------------------------------------------------------------------
POSTGRES_USER=postgres
# If you are redeploying onto an EXISTING postgres_data volume, this must match the password
# that volume was created with - changing it here does not change the password Postgres has
# already stored.
POSTGRES_PASSWORD=

# --- Secrets -------------------------------------------------------------------------------------
# Generate both with:   openssl rand -hex 32
# Changing JWT_SECRET_KEY instantly logs every user out (all existing tokens stop validating).
JWT_SECRET_KEY=
# Shared secret the backend services use to call the notification service directly (not exposed
# to the internet - see /internal/ in nginx/lms/routes.conf).
NOTIFICATION_INTERNAL_API_KEY=

# --- Optional --------------------------------------------------------------------------------
# Comma separated list of allowed browser origins, or "*". Same-origin traffic through nginx
# (the normal case) does not need CORS at all, so the default "*" is fine unless you also expose
# an API directly on the internet under a different domain than the frontend.
# CORS_ORIGINS=*

# Only needed if uploaded files (videos, PDFs, submissions) must be served from a DIFFERENT
# domain than the site itself (e.g. a separate CDN/media domain). Leave unset for the normal
# same-origin setup - URLs then default to root-relative ("/uploads/...") and work on any host.
# PUBLIC_BASE_URL=https://media.example.com

# Nginx request body size limit (file upload size ceiling). Raise if instructors upload
# lesson videos larger than this.
# CLIENT_MAX_BODY_SIZE=200m
